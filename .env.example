# ── Ollama Desktop Chatbot — Environment Configuration ──────────────────
# Copy this file to .env and fill in the values you need.
# Docker Compose will automatically load .env from the project root.

# Server port (default 8080)
PORT=8080

# Ollama URL — where the chatbot connects to Ollama
# When running with --profile with-ollama, change this to:
#   OLLAMA_URL=http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434

# Agent workspace — host directory the AI agent can read/write
# This is bind-mounted into the container at /workspace
AGENT_WORKSPACE_HOST=./workspace

# Permission mode: allow_all (default) or always_ask
AGENT_PERMISSION_MODE=allow_all

# Default command timeout in seconds (max 300 = 5 min)
AGENT_TIMEOUT_SECONDS=300

# Optional cloud API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Ollama performance tuning (when using bundled Ollama)
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2
